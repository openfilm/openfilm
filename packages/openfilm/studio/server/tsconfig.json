{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.mjs", "providers/*.mjs", "../client.mjs"],
  "exclude": ["*.test.mjs", "providers/*.test.mjs"]
}
