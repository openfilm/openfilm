{
  "name": "@openfilm/shared",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "What OpenFilm's clients share: a chat turn and its public events, the agent's activity, prompt references, titles and Markdown parsing. Part of the desktop app; not published.",
  "homepage": "https://openfilm.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfilm/openfilm.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/openfilm/openfilm/issues"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./markdown": {
      "types": "./src/markdown-blocks.ts",
      "import": "./src/markdown-blocks.ts",
      "default": "./src/markdown-blocks.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
