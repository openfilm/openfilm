{
  "name": "@openfilm/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "What OpenFilm's clients and the OpenFilm service share: a chat turn and its public events, the agent's activity, prompt references, titles, Markdown parsing, and the public API contract.",
  "homepage": "https://openfilm.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfilm/openfilm.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/openfilm/openfilm/issues"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./markdown": {
      "types": "./src/markdown-blocks.ts",
      "import": "./src/markdown-blocks.ts",
      "default": "./src/markdown-blocks.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./api/errors": {
      "types": "./src/api/errors.ts",
      "import": "./src/api/errors.ts",
      "default": "./src/api/errors.ts"
    },
    "./api/error-codes": {
      "types": "./src/api/error-codes.d.mts",
      "default": "./src/api/error-codes.mjs"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
