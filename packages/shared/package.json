{
  "name": "@openfilm/shared",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "What OpenFilm's clients share: a chat turn and its public events, the agent's activity, prompt references, titles and Markdown parsing.",
  "homepage": "https://openfilm.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openfilm/openfilm.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/openfilm/openfilm/issues"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./markdown": {
      "types": "./src/markdown-blocks.ts",
      "import": "./src/markdown-blocks.ts",
      "default": "./src/markdown-blocks.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./markdown": {
        "types": "./dist/markdown-blocks.d.ts",
        "default": "./dist/markdown-blocks.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
